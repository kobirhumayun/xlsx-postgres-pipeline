# Database Connection
# PostgreSQL connection string for Docker Compose; use the service hostname 'db' inside containers.
DATABASE_URL="postgresql://postgres:postgres@db:5432/xlsx_pipeline?schema=public"
# Alternative PostgreSQL connection string for running the app directly on your machine with npm run dev.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xlsx_pipeline?schema=public"

# pgAdmin (Optional Tools)
# Login email for the optional pgAdmin web UI container.
PGADMIN_DEFAULT_EMAIL=admin@admin.com
# Login password for the optional pgAdmin web UI container.
PGADMIN_DEFAULT_PASSWORD=root

# Backup Service
# Cron schedule for automated backups in the backup container; this example runs daily at midnight.
BACKUP_SCHEDULE="0 0 * * *"
# Number of days to keep backup files before the backup script removes older files.
RETENTION_DAYS=7
# Optional backup directory override; defaults to /backups in Docker.
# BACKUP_DIR="/backups"
# Bundle supported client versions; scripts choose the source/destination major automatically.
# Rebuild both images after changing these build settings. The former singular
# POSTGRES_CLIENT_MAJOR setting is no longer used.
POSTGRES_CLIENT_MAJORS="16 17 18"
# This release provides all three client packages.
POSTGRES_ALPINE_VERSION=3.23
# Optional independent backup source and restore destination; both default to DATABASE_URL.
# Use 'db' instead of localhost when connecting to the local database from Docker.
# BACKUP_DATABASE_URL="postgresql://postgres:postgres@db:5432/xlsx_pipeline?schema=public"
# RESTORE_DATABASE_URL="postgresql://USER:PASSWORD@CLOUD_HOST:PORT/EMPTY_DATABASE?sslmode=require"
# For certificate validation, use sslmode=verify-full&sslrootcert=/certs/ca.pem
# and mount your provider's CA file at that path in the app container.

# Maximum number of rows returned to the Query page for on-screen preview.
QUERY_PREVIEW_LIMIT=1000
# PostgreSQL statement timeout in milliseconds for query preview and export sessions.
QUERY_STATEMENT_TIMEOUT_MS=60000
